# Servidor
PORT=3000

# Base de datos principal (Prisma)
DATABASE_URL="file:./app.db"

# Base externa de registros de Minecraft (Sequelize)
MC_DB="./mc_dbs.db"

# Autenticación
JWT_SECRET="cambia-este-secreto-en-produccion"
EXPIRES_IN="1h"

# Origen permitido por CORS (panel)
FRONTEND_URL=http://localhost:5173

# API de dehashes
DEHASH_API=http://127.0.0.1:8000
