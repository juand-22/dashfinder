generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  password        String
  key             String    @unique
  roleId          Int       @default(1)
  role            Role      @relation(fields: [roleId], references: [id])
  modConfigurated Boolean   @default(false)
  modNicknames ModNicknames[]
  servers         Servers[]
  activity        Activity?
  dehashResults   DehashResults[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@map("users")
}

model Activity {
  id               Int                        @id @default(autoincrement())
  userId           Int                        @unique
  user             User                       @relation(fields: [userId], references: [id])
  lastDateRequest  DateTime
  serverip         String
  createdAt        DateTime                   @default(now())
  lastPlayers ActiviteLastPlayers[]
  lastFoundPlayers ActivityLastFoundPlayers[]

  @@map("activities")
}

model ActiviteLastPlayers {
  id         Int      @id @default(autoincrement())
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id])
  name       String
  rank       String
  found      Boolean  @default(false)
  records_founds Int @default(0)
  hashedPassword Boolean @default(false)
  createdAt  DateTime @default(now())

  @@map("activite_last_players")
}

model ActivityLastFoundPlayers {
  id         Int      @id @default(autoincrement())
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id])
  name       String
  rank       String
  found      Boolean  @default(false)
  ip         String?
  password   String?
  salt       String?
  serverip   String?
  servername String?

  @@map("activite_last_found_players")
}

model Servers {
  id        Int             @id @default(autoincrement())
  name      String
  ip        String
  port      Int
  userId    Int
  user      User            @relation(fields: [userId], references: [id])
  players   PlayerServers[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@map("servers")
}

model PlayerServers {
  id         Int      @id @default(autoincrement())
  serverId   Int
  server     Servers  @relation(fields: [serverId], references: [id])
  name       String
  rank       String?
  found      Boolean  @default(false)
  records_founds Int @default(0)
  hashedPassword Boolean @default(false)
  ip         String?
  password   String?
  salt       String?
  serverip   String?
  servername String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("player_servers")
}

model DehashResults {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id])
  hash String
  name String?
  cacheKey String @default("")
  salt String?
  algo String?
  recipes String?
  status String @default("DEHASHING")
  result String?
  error String?
  algorithm String?
  recipe String?
  candidates Int?
  elapsed Float?
  tolerant Boolean @default(false)
  missingPosition Int?
  missingChar String?
  cached Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([cacheKey])
  @@index([userId, createdAt])
  @@map("dehash_results")
}


model ModNicknames {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id])
  nickname String
  found Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("mod_nicknames")
}